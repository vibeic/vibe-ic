# Yosys post-process: flatten the scan-inserted netlist and rename all
# internal identifiers to plain N<digits> — eliminates backslash-escaped
# names with embedded dots that break Fault's iverilog testbench.
#
# Originally written in v052 with hard-coded paths; generalised in v0.63.
# Drive via environment variables so the skill is PDK-agnostic:
#   LIBERTY       — Liberty file for the std-cell library
#   SCAN_NETLIST  — scan-inserted Verilog netlist to clean
#   FLAT_OUT      — output path for the flattened, renamed netlist
#   TOP           — top module name

read_liberty -lib [getenv LIBERTY]
read_verilog [getenv SCAN_NETLIST]

hierarchy -top [getenv TOP]
flatten
opt_clean -purge
rename -enumerate

write_verilog -noattr [getenv FLAT_OUT]
stat
