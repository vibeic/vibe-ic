          "描述": "取得 chip identifier(magic string)"
        },
        {
          "操作": "**Version query**",
          "方式": "讀 `ADDR_VERSION`(0x02)",
          "描述": "取得版本字串"
        },
        {
          "操作": "**INIT new hash**",
          "方式": "寫 `ADDR_CTRL`(0x08)bit0=1",
          "描述": "開始新 hash 計算(internal H[] 歸 NIST initial values)"
        },
        {
          "操作": "**NEXT continue**",
          "方式": "寫 `ADDR_CTRL`(0x08)bit1=1",
          "描述": "從前一次 H[] 繼續計算下一個 block(用於 multi-block message)"
        },
        {
          "操作": "**MODE select**",
          "方式": "寫 `ADDR_CTRL`(0x08)bit2",
          "描述": "1 = SHA-256,0 = SHA-224"
        },
        {
          "操作": "**Load block**",
          "方式": "寫 `ADDR_BLOCK0..15`(0x10-0x1F)",
          "描述": "連續寫入 16 個 32-bit word(共 512-bit message block)"
        },
        {
          "操作": "**Read status**",
          "方式": "讀 `ADDR_STATUS`(0x09)",
          "描述": "bit0 = READY,bit1 = VALID"
        },
        {
          "操作": "**Read digest**",
          "方式": "讀 `ADDR_DIGEST0..7`(0x20-0x27)",
          "描述": "連續讀 8 個 32-bit word(SHA-256 為全 8,SHA-224 為前 7)"
        }
