library (tt27) {
  delay_model : table_lookup;
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  capacitive_load_unit (1, pf);
  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_fall : 80;
  nom_process : 1;
  nom_voltage : 1.2;
  nom_temperature : 27;
  operating_conditions (tt27) {
    process : 1;
    voltage : 1.2;
    temperature : 27;
  }
  default_operating_conditions : tt27;
  cell (delta_sigma) {
    is_macro_cell : true;
    pg_pin (vdd) { pg_type : primary_power; voltage_name : vdd; }
    pg_pin (vss) { pg_type : primary_ground; voltage_name : vss; }
    pin (vin) { direction : input; is_analog : true; }
    pin (vrefp) { direction : input; is_analog : true; }
    pin (vrefn) { direction : input; is_analog : true; }
    pin (clk) { direction : input; clock : true; }
    pin (bit_out) {
      direction : output;
      timing () {
        related_pin : "clk";
        timing_type : rising_edge;
        timing_sense : non_unate;
        cell_rise (scalar) { values ("12.7267952298896"); }
        cell_fall (scalar) { values ("11.8775026784452"); }
        rise_transition (scalar) { values ("1.16679998324817"); }
        fall_transition (scalar) { values ("0.542291794506346"); }
      }
    }
  }
}
