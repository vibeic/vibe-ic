{
  "fields": {
    "ic_name": "EtherCAT (IEC 61158 Type 12)",
    "channels": [
      {"name": "ECAT_P0_TXP / TXN",   "interface": "Ethernet Port 0 (upstream)",   "direction": "ESC → wire",  "purpose": "100BASE-TX or 1000BASE-T differential transmit pair to upstream neighbour or MainDevice.", "active_levels": "MLT-3 or PAM-5 differential, transformer-coupled", "idle_level": "Idle pattern (link-pulse / Auto-Negotiation FLP)"},
      {"name": "ECAT_P0_RXP / RXN",   "interface": "Ethernet Port 0 (upstream)",   "direction": "wire → ESC",  "purpose": "100BASE-TX / 1000BASE-T differential receive pair.",                                       "active_levels": "MLT-3 / PAM-5 differential",                       "idle_level": "Link-pulse / FLP"},
      {"name": "ECAT_P1_TXP / TXN",   "interface": "Ethernet Port 1 (downstream)", "direction": "ESC → wire",  "purpose": "Forward frame to next SubDevice; on link-down, ESC closes loop internally.",               "active_levels": "MLT-3 / PAM-5 differential",                       "idle_level": "Link-pulse"},
      {"name": "ECAT_P1_RXP / RXN",   "interface": "Ethernet Port 1 (downstream)", "direction": "wire → ESC",  "purpose": "Receive frame returning from downstream segment.",                                          "active_levels": "MLT-3 / PAM-5 differential",                       "idle_level": "Link-pulse"},
      {"name": "ECAT_P2 / P3 (opt)",  "interface": "Ethernet Port 2/3 (branch)",   "direction": "bidirectional", "purpose": "Optional 3rd / 4th ports for tree / star topologies (e.g. ET1815, ET1816 ESCs).",          "active_levels": "MLT-3 / PAM-5 differential",                       "idle_level": "Link-pulse"},
      {"name": "MDC",                 "interface": "MII Management",              "direction": "ESC → PHY",    "purpose": "MII Management clock, ≤ 2.5 MHz.",                                                          "active_levels": "LVTTL/LVCMOS",                                     "idle_level": "0"},
      {"name": "MDIO",                "interface": "MII Management",              "direction": "bidirectional", "purpose": "MII Management data; three-state with 1.5 kΩ pull-up at PHY.",                              "active_levels": "LVTTL/LVCMOS three-state",                          "idle_level": "Hi-Z"},
      {"name": "EEPROM_SCL",          "interface": "SII (EEPROM)",                "direction": "ESC → EEPROM", "purpose": "I²C-compatible 2-wire clock to external SII EEPROM.",                                       "active_levels": "Open-drain, 4.7 kΩ pull-up",                       "idle_level": "Hi-Z (released = high)"},
      {"name": "EEPROM_SDA",          "interface": "SII (EEPROM)",                "direction": "bidirectional", "purpose": "I²C-compatible 2-wire data.",                                                                "active_levels": "Open-drain, 4.7 kΩ pull-up",                       "idle_level": "Hi-Z"},
      {"name": "SYNC0",               "interface": "Distributed Clocks",          "direction": "ESC → µC",     "purpose": "First DC interrupt / sync pulse output; period programmable in 0x0990.",                    "active_levels": "LVTTL/LVCMOS",                                     "idle_level": "0"},
      {"name": "SYNC1",               "interface": "Distributed Clocks",          "direction": "ESC → µC",     "purpose": "Second DC pulse; period in 0x0994.",                                                         "active_levels": "LVTTL/LVCMOS",                                     "idle_level": "0"},
      {"name": "LATCH0",              "interface": "Distributed Clocks",          "direction": "µC → ESC",     "purpose": "External event input — capture System Time on configurable edge.",                          "active_levels": "LVTTL/LVCMOS, edge-sensitive",                     "idle_level": "0"},
      {"name": "LATCH1",              "interface": "Distributed Clocks",          "direction": "µC → ESC",     "purpose": "Second event latch input.",                                                                 "active_levels": "LVTTL/LVCMOS, edge-sensitive",                     "idle_level": "0"},
      {"name": "PDI_CS_n",            "interface": "PDI (µC bus / SPI)",          "direction": "µC → ESC",     "purpose": "Chip select for PDI bus / SPI slave.",                                                       "active_levels": "Active LOW",                                       "idle_level": "1"},
      {"name": "PDI_ADDR[15:0]",      "interface": "PDI (µC bus)",                "direction": "µC → ESC",     "purpose": "PDI address bus (asynchronous / synchronous µC bus).",                                       "active_levels": "LVTTL/LVCMOS",                                     "idle_level": "Don't care when CS=1"},
      {"name": "PDI_DATA[7:0 / 15:0]","interface": "PDI (µC bus)",                "direction": "bidirectional", "purpose": "PDI data bus 8-bit or 16-bit.",                                                              "active_levels": "LVTTL/LVCMOS",                                     "idle_level": "Hi-Z when not driving"},
      {"name": "PDI_WR_n / RD_n",     "interface": "PDI (µC bus)",                "direction": "µC → ESC",     "purpose": "Write / Read strobe.",                                                                       "active_levels": "Active LOW",                                       "idle_level": "1"},
      {"name": "PDI_READY",           "interface": "PDI (µC bus)",                "direction": "ESC → µC",     "purpose": "Wait-state signal for slow accesses.",                                                       "active_levels": "Active HIGH = ready",                              "idle_level": "1"},
      {"name": "PDI_IRQ",             "interface": "PDI (interrupt)",             "direction": "ESC → µC",     "purpose": "Interrupt output to local µC; mask in 0x0200-0x020F.",                                       "active_levels": "Active HIGH or LOW (configurable)",                "idle_level": "Inactive"},
      {"name": "SPI_SCK / MOSI / MISO","interface": "PDI (SPI)",                  "direction": "various",      "purpose": "SPI clock + MOSI (µC → ESC) + MISO (ESC → µC) for SPI-PDI mode.",                            "active_levels": "LVTTL/LVCMOS",                                     "idle_level": "SCK idle per CPOL"},
      {"name": "PDI_DIO_OUT[31:0]",   "interface": "PDI (Digital I/O)",           "direction": "ESC → external","purpose": "Up to 32 output pins driven directly from ESC DPRAM; no µC required.",                       "active_levels": "LVTTL/LVCMOS",                                     "idle_level": "Last-written value"},
      {"name": "PDI_DIO_IN[31:0]",    "interface": "PDI (Digital I/O)",           "direction": "external → ESC","purpose": "Up to 32 input pins sampled into ESC DPRAM.",                                                "active_levels": "LVTTL/LVCMOS",                                     "idle_level": "Sampled"},
      {"name": "LED_RUN",             "interface": "Diagnostic",                  "direction": "ESC → LED",    "purpose": "Indicates ESM state per IEC 61784-2 (Init=off, PreOp=blink, SafeOp=single-flash, Op=on).",   "active_levels": "Active HIGH",                                      "idle_level": "Pattern-coded"},
      {"name": "LED_ERR",             "interface": "Diagnostic",                  "direction": "ESC → LED",    "purpose": "Indicates AL Status error (single-flash, double-flash, etc.).",                              "active_levels": "Active HIGH",                                      "idle_level": "Off if no error"},
      {"name": "LED_LINK_P0 / P1",    "interface": "Diagnostic",                  "direction": "PHY → LED",    "purpose": "Per-port link state (on = link up).",                                                        "active_levels": "Active HIGH",                                      "idle_level": "Off"},
      {"name": "LED_ACT_P0 / P1",     "interface": "Diagnostic",                  "direction": "PHY → LED",    "purpose": "Per-port activity (blink on TX/RX).",                                                        "active_levels": "Blinking",                                         "idle_level": "Off"},
      {"name": "RESET_n",             "interface": "Reset",                       "direction": "external → ESC","purpose": "Hard reset input; asynchronous.",                                                            "active_levels": "Active LOW",                                       "idle_level": "1"},
      {"name": "CLK25",               "interface": "Clock",                       "direction": "external → ESC","purpose": "25 MHz crystal or oscillator input for PHY + ESC core; some ESCs use 50 MHz.",               "active_levels": "Square wave 25 MHz",                               "idle_level": "Running"}
    ],
    "esc_typical_pin_count_by_role": {
      "Ethernet ports (2-port)": 12,
      "Ethernet ports (3-port)": 18,
      "Ethernet ports (4-port)": 24,
      "MII Management (MDC + MDIO)": 2,
      "SII EEPROM (SCL + SDA)": 2,
      "PDI µC bus (16-bit async)": 38,
      "PDI SPI slave": 5,
      "PDI DIO (32 out + 32 in)": 64,
      "DC signals (SYNC0/1 + LATCH0/1)": 4,
      "Diagnostic LEDs": 8,
      "Power + Ground (typical)": "16-24"
    }
  }
}
