{
  "fields": {
    "ic_name": "EtherCAT (IEC 61158 Type 12)",
    "ethercat_frame_table": [
      {"offset_bytes": 0,  "field": "Destination MAC", "size_bytes": 6,  "notes": "Unconstrained (any unicast / multicast). EtherCAT typically uses 01:01:05:01:00:00 broadcast or the MainDevice's local MAC."},
      {"offset_bytes": 6,  "field": "Source MAC",      "size_bytes": 6,  "notes": "MainDevice's NIC MAC."},
      {"offset_bytes": 12, "field": "EtherType",       "size_bytes": 2,  "notes": "0x88A4 (EtherCAT). Or 0x0800 if UDP/IP encapsulated."},
      {"offset_bytes": 14, "field": "EtherCAT Header", "size_bytes": 2,  "notes": "Length[10:0] + Reserved[11] + Type[15:12]=0x1."},
      {"offset_bytes": 16, "field": "Datagram Block",  "size_bytes": "variable, 1-1486", "notes": "One or more chained datagrams."},
      {"offset_bytes": "Frame_end - 4", "field": "FCS", "size_bytes": 4, "notes": "Standard Ethernet CRC-32."}
    ],
    "ethercat_header_bit_table": [
      {"bit_field": "Length",   "bits": "10:0",  "purpose": "Total length of all following datagrams in bytes."},
      {"bit_field": "Reserved", "bits": "11",    "purpose": "0"},
      {"bit_field": "Type",     "bits": "15:12", "purpose": "0x1=ESC datagram, 0x4=Network Variables (EAP), 0x5=Mailbox-only"}
    ],
    "datagram_header_bit_table": [
      {"offset_bytes": 0,  "field": "Cmd",         "size_bits": 8,  "purpose": "Command code (0x00-0x0E)."},
      {"offset_bytes": 1,  "field": "Idx",         "size_bits": 8,  "purpose": "MainDevice-local datagram index, returned unchanged."},
      {"offset_bytes": 2,  "field": "Address",     "size_bits": 32, "purpose": "Cmd-dependent (Position/Configured/Broadcast/Logical)."},
      {"offset_bytes": 6,  "field": "Length",      "size_bits": 11, "purpose": "Data length 1..1486 bytes."},
      {"offset_bytes": 6,  "field": "Reserved",    "size_bits": 3,  "purpose": "0"},
      {"offset_bytes": 6,  "field": "Circulating", "size_bits": 1,  "purpose": "Already gone around once."},
      {"offset_bytes": 6,  "field": "Next",        "size_bits": 1,  "purpose": "1 = another datagram follows."},
      {"offset_bytes": 8,  "field": "IRQ",         "size_bits": 16, "purpose": "AL Status interrupt aggregate."}
    ],
    "command_code_table": [
      {"cmd_hex": "0x00", "name": "NOP",  "addressing": "—",         "wkc_inc": 0,  "use": "No-op"},
      {"cmd_hex": "0x01", "name": "APRD", "addressing": "Position",  "wkc_inc": 1,  "use": "Start-up enumeration"},
      {"cmd_hex": "0x02", "name": "APWR", "addressing": "Position",  "wkc_inc": 1,  "use": "Start-up register write"},
      {"cmd_hex": "0x03", "name": "APRW", "addressing": "Position",  "wkc_inc": 3,  "use": "Start-up atomic read+write"},
      {"cmd_hex": "0x04", "name": "FPRD", "addressing": "Configured","wkc_inc": 1,  "use": "Targeted register read"},
      {"cmd_hex": "0x05", "name": "FPWR", "addressing": "Configured","wkc_inc": 1,  "use": "Targeted register write"},
      {"cmd_hex": "0x06", "name": "FPRW", "addressing": "Configured","wkc_inc": 3,  "use": "Targeted atomic read+write"},
      {"cmd_hex": "0x07", "name": "BRD",  "addressing": "Broadcast", "wkc_inc": 1,  "use": "Network-wide status sweep"},
      {"cmd_hex": "0x08", "name": "BWR",  "addressing": "Broadcast", "wkc_inc": 1,  "use": "Network-wide config"},
      {"cmd_hex": "0x09", "name": "BRW",  "addressing": "Broadcast", "wkc_inc": 3,  "use": "Network-wide atomic"},
      {"cmd_hex": "0x0A", "name": "LRD",  "addressing": "Logical",   "wkc_inc": 1,  "use": "Cyclic process-data Inputs"},
      {"cmd_hex": "0x0B", "name": "LWR",  "addressing": "Logical",   "wkc_inc": 1,  "use": "Cyclic process-data Outputs"},
      {"cmd_hex": "0x0C", "name": "LRW",  "addressing": "Logical",   "wkc_inc": 3,  "use": "Combined cyclic IO"},
      {"cmd_hex": "0x0D", "name": "ARMW", "addressing": "Pos+MWrite","wkc_inc": 1,  "use": "DC time propagation"},
      {"cmd_hex": "0x0E", "name": "FRMW", "addressing": "FP+MWrite", "wkc_inc": 1,  "use": "Re-distribute value from FP-addressed SubDevice"}
    ],
    "esm_state_table": [
      {"state": "Init",   "code_hex": "0x01", "description": "Initial after power-up; no mailbox, no process-data."},
      {"state": "PreOp",  "code_hex": "0x02", "description": "Mailbox only; CoE/SoE/EoE/FoE/AoE active."},
      {"state": "Boot",   "code_hex": "0x03", "description": "Firmware-update state; only FoE."},
      {"state": "SafeOp", "code_hex": "0x04", "description": "Process-data active; Inputs valid; Outputs in Safe state."},
      {"state": "Op",     "code_hex": "0x08", "description": "Full bidirectional cyclic; Outputs drive hardware."},
      {"state": "Error",  "code_hex": "+0x10", "description": "OR'ed into previous-state code in AL Status when SubDevice cannot satisfy a transition (e.g. 0x14 = PreOp+Error)."}
    ],
    "mailbox_protocol_type_table": [
      {"mbx_type_hex": "0x01", "name": "AoE",  "long_name": "ADS over EtherCAT"},
      {"mbx_type_hex": "0x02", "name": "EoE",  "long_name": "Ethernet over EtherCAT"},
      {"mbx_type_hex": "0x03", "name": "CoE",  "long_name": "CANopen over EtherCAT"},
      {"mbx_type_hex": "0x04", "name": "FoE",  "long_name": "File access over EtherCAT"},
      {"mbx_type_hex": "0x05", "name": "SoE",  "long_name": "Servo Profile (Sercos) over EtherCAT"},
      {"mbx_type_hex": "0x0F", "name": "VoE",  "long_name": "Vendor-specific over EtherCAT"}
    ],
    "addressing_mode_summary_table": [
      {"mode": "Auto-Increment (AP)", "address_high_word": "Signed 16-bit Position (incremented at each SubDevice; match @0)", "address_low_word": "16-bit local ESC offset", "cmd_codes": ["APRD","APWR","APRW","ARMW"]},
      {"mode": "Configured (FP)",     "address_high_word": "16-bit Configured Station Address (0x0010)",                       "address_low_word": "16-bit local ESC offset", "cmd_codes": ["FPRD","FPWR","FPRW","FRMW"]},
      {"mode": "Broadcast (BC)",      "address_high_word": "Ignored",                                                          "address_low_word": "16-bit local ESC offset", "cmd_codes": ["BRD","BWR","BRW"]},
      {"mode": "Logical (LOG)",       "address_high_word": "Part of 32-bit Logical Address",                                   "address_low_word": "Part of 32-bit Logical Address", "cmd_codes": ["LRD","LWR","LRW"]}
    ],
    "al_status_code_table": [
      {"code_hex": "0x0000", "description": "No error"},
      {"code_hex": "0x0011", "description": "Invalid requested state change"},
      {"code_hex": "0x0012", "description": "Unknown requested state"},
      {"code_hex": "0x0013", "description": "Bootstrap not supported"},
      {"code_hex": "0x0014", "description": "No valid firmware"},
      {"code_hex": "0x0015", "description": "Invalid mailbox configuration (Bootstrap)"},
      {"code_hex": "0x0016", "description": "Invalid mailbox configuration (Pre-Operational)"},
      {"code_hex": "0x0017", "description": "Invalid SyncManager configuration"},
      {"code_hex": "0x0018", "description": "No valid inputs available"},
      {"code_hex": "0x0019", "description": "No valid outputs"},
      {"code_hex": "0x001A", "description": "Synchronization error"},
      {"code_hex": "0x001B", "description": "SyncManager watchdog"},
      {"code_hex": "0x001D", "description": "Invalid Output Configuration"},
      {"code_hex": "0x001E", "description": "Invalid Input Configuration"},
      {"code_hex": "0x001F", "description": "Invalid Watchdog Configuration"},
      {"code_hex": "0x0020", "description": "SubDevice needs cold start"},
      {"code_hex": "0x002C", "description": "Fatal sync error"},
      {"code_hex": "0x002D", "description": "No Sync Error"},
      {"code_hex": "0x0030", "description": "DC Invalid Sync Configuration"},
      {"code_hex": "0x0031", "description": "DC Invalid Latch Configuration"},
      {"code_hex": "0x0032", "description": "DC PLL Sync Error"},
      {"code_hex": "0x0033", "description": "DC Sync IO Error"},
      {"code_hex": "0x0034", "description": "DC Sync Timeout"},
      {"code_hex": "0x0035", "description": "DC Invalid Sync Cycle Time"},
      {"code_hex": "0x0036", "description": "DC Sync0 Cycle Time"},
      {"code_hex": "0x0037", "description": "DC Sync1 Cycle Time"},
      {"code_hex": "0x0042", "description": "MBX_EOE"},
      {"code_hex": "0x0043", "description": "MBX_COE"},
      {"code_hex": "0x0044", "description": "MBX_FOE"},
      {"code_hex": "0x0045", "description": "MBX_SOE"},
      {"code_hex": "0x004F", "description": "MBX_VOE"},
      {"code_hex": "0x0050", "description": "EEPROM no access"}
    ],
    "mbx_header_table": [
      {"offset_bytes": 0, "field": "Length",            "size_bytes": 2, "purpose": "Mailbox data length"},
      {"offset_bytes": 2, "field": "Address",           "size_bytes": 2, "purpose": "Routing station address"},
      {"offset_bytes": 4, "field": "Channel+Priority",  "size_bytes": 1, "purpose": "Channel[5:0] + Priority[7:6]"},
      {"offset_bytes": 5, "field": "Type+Counter",      "size_bytes": 1, "purpose": "Type[3:0] (mailbox protocol) + Counter[6:4] + Reserved[7]"}
    ],
    "fcs_polynomial_table": {
      "polynomial_hex": "0x04C11DB7",
      "reflected_hex": "0xEDB88320",
      "init_hex": "0xFFFFFFFF",
      "final_xor_hex": "0xFFFFFFFF",
      "bit_order": "LSB-first within each byte",
      "comment": "Identical to IEEE 802.3 Ethernet CRC-32."
    },
    "sm_mode_encoding_table": [
      {"control_byte_bits": "1:0", "value": "00", "meaning": "3-buffer mode (process data)"},
      {"control_byte_bits": "1:0", "value": "01", "meaning": "Reserved"},
      {"control_byte_bits": "1:0", "value": "10", "meaning": "Mailbox mode"},
      {"control_byte_bits": "1:0", "value": "11", "meaning": "Reserved"},
      {"control_byte_bits": "3:2", "value": "00", "meaning": "Read access (Outputs from MainDevice's perspective; PDI reads)"},
      {"control_byte_bits": "3:2", "value": "01", "meaning": "Write access (Inputs from MainDevice's perspective; PDI writes)"}
    ]
  }
}
