  "protocol_type": "Multi-IO command-oriented memory protocol. Each transaction is framed by CS# and consists of an instruction phase, an address phase (3/4 byte), optional mode/alternate bits, programmable dummy cycles, and a data phase. Each phase may run over 1/2/4/8 data lines (SDR or DDR), expressed as the protocol-mode notation S-A-D.",
  "channels": [
    {
      "name": "SCLK",
      "direction": "controller -> device",
      "description": "Serial clock; SDR captures one edge, DDR both edges."
    },
    {
      "name": "CS#",
      "direction": "controller -> device",
      "description": "Active-low chip select; frames each command."
    },
    {
      "name": "IO0..IO3 / IO0..IO7",
      "direction": "bidirectional",
      "description": "Multi-IO data lines; direction set per phase. IO0=MOSI and IO1=MISO in single mode; /WP->IO2, /HOLD->IO3 in Quad."
    },
    {
      "name": "DQS",
      "direction": "device -> controller (octal DDR)",
      "description": "Optional source-synchronous read data strobe."
    }
  ],
  "burst_based": true,
  "lsbfe_control": "LSBFE bit (SPICR1 bit 0): 0 = MSB-first, 1 = LSB-first.",
  "byte_order": "Configurable MSB-first or LSB-first per LSBFE",
  "single_response_for_write": "No separate response channel; the same shift register cycle exchanges TX and RX data simultaneously.",
  "per_beat_response_for_read": "No; data on MISO is the slave's shift-out concurrent with master's MOSI shift-out.",
  "valid_ready_handshake_rules": [
    "There is no VALID/READY style handshake; SPI uses a free-running shift clock and a discrete SS slave-select.",
    "Master drives 16 SCK edges to complete an 8-bit transfer (8 sample + 8 shift edges).",
    "Slave aligns to master SCK and samples on the polarity+phase-defined edge."
