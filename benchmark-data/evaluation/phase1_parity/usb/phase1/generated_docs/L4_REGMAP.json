    },
    "wIndex": {
      "width_bits": 16,
      "purpose": "Request-specific parameter (e.g. endpoint number, interface number)"
    },
    "wLength": {
      "width_bits": 16,
      "purpose": "Length of subsequent data stage (host-to-device max for OUT; device-to-host max for IN)"
    }
  },
