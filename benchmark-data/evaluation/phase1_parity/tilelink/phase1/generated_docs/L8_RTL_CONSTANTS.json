    "ID_WIDTH_bits": "Implementation-defined; typically 1-8 bits on master side; slave side >= master + log2(num_masters).",
    "RRESP_BRESP_width": "2 bits each",
    "USER_width": "0 (optional; implementation-defined when present).",
