    }
  },
  "burst_length_formula": {
    "AXI3": "Burst_Length = AxLEN[3:0] + 1   (range 1..16)",
    "AXI4": "Burst_Length = AxLEN[7:0] + 1   (INCR: 1..256; FIXED/WRAP: 1..16)",
    "AXI5": "Burst_Length = AxLEN[7:0] + 1   (same as AXI4)"
  },
  "response_encoding_xRESP": {
    "0b00": "OKAY",
