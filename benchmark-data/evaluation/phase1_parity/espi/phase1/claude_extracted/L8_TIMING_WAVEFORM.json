{
  "ic_name": "Enhanced Serial Peripheral Interface (eSPI)",
  "timing_constants": {
    "clk_freq_mhz": {
      "boot": 20,
      "max": 66
    },
    "tSU_ns": 2,
    "tHO_ns": 1,
    "cs_to_clk_setup_clocks": 2,
    "turnaround_clocks": 2,
    "reset_pulse_min_us": 100
  },
  "clock_and_data_waveform": {
    "clk_idle": "low",
    "drive_edge": "rising (command phase)",
    "sample_edge": "falling (command phase)",
    "turnaround": "bus floats for 2 ESPI_CLK cycles when ownership reverses"
  },
  "transaction_waveform": {
    "order": [
      "CS# assert",
      "CMD opcode (8 bits)",
      "command fields",
      "optional data",
      "CRC byte",
      "TAR (2 clk float)",
      "response code (8 bits)",
      "response data/status",
      "CRC byte",
      "CS# deassert"
    ]
  }
}
