{
  "fields": {
    "ic_name": "ARM Serial Wire Debug (SWD) — ADIv5 (ARM IHI 0031C)",
    "swd_transaction_phases_table": {
      "header_columns": ["Phase Index", "Phase Name", "Bits", "Direction", "Notes"],
      "rows": [
        [1, "Request",       "8",   "host → target", "Start + APnDP + RnW + A[2] + A[3] + Parity + Stop + Park (LSB first)"],
        [2, "Turnaround A",  "1",   "transitional",  "1 SWCLK (configurable 1-4 via CTRL/STAT.TRNCNT); SWDIO flips from host-driven to target-driven"],
        [3, "ACK",           "3",   "target → host", "001=OK, 010=WAIT, 100=FAULT (LSB first)"],
        [4, "Data",          "32",  "Read: target→host; Write: host→target", "32-bit payload (LSB first)"],
        [5, "Data Parity",   "1",   "same as Data",  "Even parity over the 32 data bits"],
        [6, "Turnaround B",  "1",   "transitional",  "1 SWCLK (configurable 1-4); SWDIO flips back to host-driven"]
      ]
    },
    "request_field_table": {
      "header_columns": ["Bit", "Field Name", "Value", "Description"],
      "rows": [
        [0, "Start",  "1", "Always 1 — marks start of Request packet"],
