        [2, "RnW",    "0=Write, 1=Read", "Read/write select"],
        [3, "A[2]",   "0 or 1", "Register address bit 2"],
        [4, "A[3]",   "0 or 1", "Register address bit 3"],
        [5, "Parity", "even parity", "Even parity over APnDP+RnW+A[2:3]"],
        [6, "Stop",   "0", "Always 0"],
        [7, "Park",   "1", "Always 1 — leaves SWDIO HIGH before Turnaround"]
      ]
    },
