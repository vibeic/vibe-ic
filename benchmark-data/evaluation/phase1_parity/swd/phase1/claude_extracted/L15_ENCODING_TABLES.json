      "rows": [
        ["001", 1, "OK",    "Transaction accepted; data is valid", "Proceed normally"],
        ["010", 2, "WAIT",  "Target busy; data field is junk",     "Retry the same Request"],
        ["100", 4, "FAULT", "Sticky error has occurred",            "Read CTRL/STAT, write ABORT clear bits, retry"]
      ]
    },
