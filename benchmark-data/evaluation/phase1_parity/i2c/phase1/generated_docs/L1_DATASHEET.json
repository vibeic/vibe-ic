  "document_number": "UM10204",
  "document_title": "I2C-bus specification and user manual",
  "version": "Rev. 6",
  "revised_date": "4 April 2014",
  "manufacturer": "NXP Semiconductors (originally Philips Semiconductors)",
  "copyright": "© NXP Semiconductors N.V. 2014",
  "external_pins": [
    "SDA",
    "SCL"
  ],
  "total_external_pin_count": 2,
  "wire_protocol": "Open-drain / open-collector, wired-AND, two-wire bidirectional serial",
  "key_features": [
    "Only two bus lines are required: a serial data line (SDA) and a serial clock line (SCL).",
    "Each device connected to the bus is software addressable by a unique address; simple master/slave relationships exist at all times.",
    "Masters can operate as master-transmitters or master-receivers.",
    "True multi-master bus including collision detection and arbitration to prevent data corruption.",
    "Serial 8-bit oriented bidirectional data transfers up to 100 kbit/s (Standard-mode), 400 kbit/s (Fast-mode), 1 Mbit/s (Fast-mode Plus), 3.4 Mbit/s (High-speed mode).",
    "Serial 8-bit oriented unidirectional data transfers up to 5 Mbit/s (Ultra Fast-mode).",
    "On-chip filtering rejects spikes on the bus data line.",
    "Number of ICs limited only by maximum bus capacitance.",
    "Software-Reset, Device ID, General Call address, START byte, 10-bit addressing optional features."
  ],
  "modes_of_operation": [
    {
      "name": "Standard-mode (Sm)",
      "max_bit_rate": "100 kbit/s",
      "duplex": "bidirectional",
      "drive": "open-drain"
    },
    {
      "name": "Fast-mode (Fm)",
      "max_bit_rate": "400 kbit/s",
      "duplex": "bidirectional",
      "drive": "open-drain"
    },
    {
      "name": "Fast-mode Plus (Fm+)",
      "max_bit_rate": "1 Mbit/s",
      "duplex": "bidirectional",
      "drive": "open-drain"
    },
    {
      "name": "High-speed mode (Hs)",
      "max_bit_rate": "3.4 Mbit/s",
      "duplex": "bidirectional",
      "drive": "open-drain with current source"
    },
    {
      "name": "Ultra Fast-mode (UFm)",
      "max_bit_rate": "5 Mbit/s",
      "duplex": "unidirectional (push-pull)",
      "drive": "push-pull"
    }
  ],
  "system_use_cases": [
    "System Management Bus (SMBus)",
    "Power Management Bus (PMBus)",
    "Intelligent Platform Management Interface (IPMI)",
    "Display Data Channel (DDC)",
    "Advanced Telecom Computing Architecture (ATCA)"
  ],
  "overview": "The I2C-bus is a de facto world standard, implemented in over 1000 different ICs from more than 50 companies. It is a simple bidirectional 2-wire serial bus for efficient inter-IC control.",
  "release_history_note": "Originally Philips Semiconductors (now NXP). Revision history per document footer; Rev. 6 dated 4 April 2014; previous versions span 1982-2007 (v1.0..v3.0)."
