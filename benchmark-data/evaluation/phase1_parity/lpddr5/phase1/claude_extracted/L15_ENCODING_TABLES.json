        ["Multi-purpose command", "MPC",    "OP[7:0]"],
        ["Mode register write-2", "MRW-2",  "MA[6:0], OP[7:0]"],
        ["Self-refresh exit",     "SRX",    "—"],
        ["Self-refresh entry",    "SRE",    "PD, DSE"],
