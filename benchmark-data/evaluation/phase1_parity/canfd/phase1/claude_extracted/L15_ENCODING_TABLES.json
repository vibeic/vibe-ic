    },
    "frame_field_widths_table_can_fd": {
      "header_columns": ["Field", "Width (bits)", "Form"],
      "rows": [
        ["START_OF_FRAME",       "1",         "1 dominant bit"],
        ["IDENTIFIER (standard)","11",         "MSB-first"],
        ["RRS",                  "1",         "always dominant (replaces RTR; no remote frames in CAN FD)"],
        ["r1 (reserved)",        "1",         "transmitter dominant"],
        ["FDF",                  "1",         "recessive (signals CAN FD format)"],
        ["res (reserved)",       "1",         "transmitter dominant; FDF+res=11 triggers Protocol Exception"],
        ["BRS",                  "1",         "dominant=no rate switch; recessive=switch to DBTP from BRS through CRC sequence"],
        ["ESI",                  "1",         "dominant=transmitter error-active; recessive=transmitter error-passive"],
        ["DLC",                  "4",         "data byte count per CAN FD DLC table (0..64 bytes via DLC 0..15)"],
        ["DATA",                 "0..512",    "0..64 data bytes per DLC"],
        ["STUFF_COUNT (ISO only)","4",        "3-bit stuff bit count + 1-bit parity (CCCR.NISO=0)"],
        ["CRC_SEQUENCE_LE_16B",  "17",        "CAN FD CRC-17 for payload ≤16 bytes"],
        ["CRC_SEQUENCE_GT_16B",  "21",        "CAN FD CRC-21 for payload >16 bytes"],
        ["CRC_DELIMITER",        "1",         "1 recessive bit; bit rate switches back to NBTP"],
        ["ACK_SLOT",             "1",         "transmitter recessive; receivers superscribe with dominant; ACK timing accounts for transmitter delay in FD"],
        ["ACK_DELIMITER",        "1",         "1 recessive bit"],
        ["END_OF_FRAME",         "7",         "all recessive bits"],
        ["INTERMISSION",         "3",         "all recessive bits"]
