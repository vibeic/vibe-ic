{
  "ic_name": "Low Pin Count (LPC) Interface",
  "control_logic": {
    "host_fsm": [
      "Idle (LFRAME# high)",
      "Assert LFRAME# + drive START",
      "Drive CYCTYPE+DIR",
      "Drive ADDR nibbles",
      "Turnaround (release LAD)",
      "Sample SYNC from peripheral",
      "Drive/sample DATA nibbles",
      "Final turnaround",
      "Return to idle"
    ],
    "peripheral_fsm": [
      "Watch LFRAME# + decode START",
      "Decode CYCTYPE+DIR + ADDR",
      "Match own address range",
      "Turnaround (take LAD)",
      "Drive SYNC (READY/WAIT/ERROR)",
      "Drive/sample DATA nibbles",
      "Release LAD on final turnaround"
    ],
    "framing": "LFRAME# low starts a cycle; LFRAME# low for >=4 LCLK with LAD=1111 aborts.",
    "wait_states": "Peripheral inserts SHORT_WAIT (0101) or LONG_WAIT (0110) SYNC until READY (0000)."
  }
}
