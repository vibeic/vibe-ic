  "class_path": "digital_arithmetic_primitive",
  "analog_digital_interface_present": false,
  "signaling_summary": "ONFI 4.1 defines four data-interface signaling families on a common 8-bit DQ bus plus control strobes. SDR (LVCMOS at VccQ); NV-DDR (single-ended bidirectional DQS + CLK on WE_n pin); NV-DDR2 (differential DQS_t/DQS_c + ZQ Calibration + ODT); NV-DDR3 (differential DQS_t/DQS_c AND RE_t/RE_c + DCC/DQ training + matrix termination). VREFQ is the input threshold for NV-DDR2/3 single-ended path. Internal NAND-array circuitry is highly analog but out of scope.",
  "voltage_classes": [
    {
      "class": "3.3 V VccQ",
      "VccQ_range_V": "3.0 - 3.6",
      "applicable_modes": "SDR (legacy)"
    },
    {
      "class": "1.8 V VccQ",
      "VccQ_range_V": "1.7 - 1.95",
      "applicable_modes": "SDR, NV-DDR, NV-DDR2, NV-DDR3"
    },
    {
      "class": "1.2 V VccQ",
      "VccQ_range_V": "1.14 - 1.26",
      "applicable_modes": "NV-DDR2 / NV-DDR3 advanced"
    }
  ],
