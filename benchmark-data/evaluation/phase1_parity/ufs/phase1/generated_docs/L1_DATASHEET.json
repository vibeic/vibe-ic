    "DIN1_t/DIN1_c (M-PHY RX lane 1 differential pair)",
    "DOUT1_t/DOUT1_c (M-PHY TX lane 1 differential pair)",
    "VCC (NAND core supply)",
    "VCCQ (low-voltage core supply)",
    "VCCQ2 (interface supply)",
    "VSS (ground)"
  ],
