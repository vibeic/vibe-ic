{
  "ic_name": "IEEE 802.3 Management Data Input/Output (MDIO)",
  "timing_constants": {
    "mdc_max_mhz": 2.5,
    "mdc_min_period_ns": 400,
    "mdio_setup_ns": 10,
    "mdio_hold_ns": 10,
    "mdio_output_delay_max_ns": 300,
    "preamble_cycles": 32
  },
  "clock_and_data_waveform": {
    "mdc_source": "STA",
    "sample_edge": "MDIO sampled on MDC rising edge",
    "mdio_drive": "open-drain, external pull-up",
    "turnaround": "MDIO reverses direction during the 2-bit TA field (Z0 on read)"
  },
  "transaction_waveform": {
    "order": [
      "PRE (32 ones)",
      "ST (2 bits)",
      "OP (2 bits)",
      "PHYAD/PRTAD (5 bits)",
      "REGAD/DEVAD (5 bits)",
      "TA (2 bits)",
      "DATA (16 bits, MSB first)"
    ]
  }
}
