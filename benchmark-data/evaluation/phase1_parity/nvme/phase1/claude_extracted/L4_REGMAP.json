        {"bits": "11:9",  "name": "Reserved", "description": "Reserved."},
        {"bit":   8,      "name": "CQDA", "description": "CMB Queue Dword Alignment."},
        {"bit":   7,      "name": "CDMMMS", "description": "CMB Data Metadata Mixed Memory Support."},
