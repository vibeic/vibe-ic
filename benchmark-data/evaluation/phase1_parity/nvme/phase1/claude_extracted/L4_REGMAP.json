{
  "ic_name": "NVM Express (NVMe) Base Specification Rev 1.4",
  "register_map_present": true,
  "notes": "NVMe controller registers live in BAR0/BAR1 (MLBAR/MUBAR) — the PCIe Memory Space resource at offset 10h of the PCI Type 0 Configuration Header. The MMIO region must support in-order memory accesses and variable widths (32-bit / 64-bit). The standard register layout occupies offsets 0h..3FFFh (Section 3.1.).",
  "register_count": 26,
  "doorbell_offset_formula": "SQyTDBL = 1000h + (2y × (4 << CAP.DSTRD)); CQyHDBL = 1000h + ((2y + 1) × (4 << CAP.DSTRD)). CAP.DSTRD = 0 ⇒ 4-byte stride.",
  "registers": [
    {
      "offset_h": "00", "name": "CAP", "long_name": "Controller Capabilities", "width_bits": 64, "access": "RO",
      "fields": [
        {"bits": "63:58", "name": "Reserved",                                "description": "Reserved."},
        {"bit":  57,      "name": "CMBS",   "long_name": "CMB Supported",     "description": "1 = controller supports Controller Memory Buffer."},
        {"bit":  56,      "name": "PMRS",   "long_name": "PMR Supported",     "description": "1 = controller supports Persistent Memory Region."},
        {"bits": "55:52", "name": "MPSMAX", "long_name": "Memory Page Size Maximum","description": "Max host memory page size = 2^(12+MPSMAX)."},
        {"bits": "51:48", "name": "MPSMIN", "long_name": "Memory Page Size Minimum","description": "Min host memory page size = 2^(12+MPSMIN)."},
        {"bits": "47:46", "name": "Reserved",                                "description": "Reserved."},
        {"bit":  45,      "name": "BPS",    "long_name": "Boot Partition Support","description": "1 = controller supports Boot Partitions."},
        {"bits": "44:37", "name": "CSS",    "long_name": "Command Sets Supported","description": "Bitmap: bit 37 = NVM Command Set; bit 44 = Admin-only (no I/O Set)."},
        {"bit":  36,      "name": "NSSRS",  "long_name": "NVM Subsystem Reset Supported","description": "1 = controller supports NVM Subsystem Reset feature."},
        {"bits": "35:32", "name": "DSTRD",  "long_name": "Doorbell Stride",   "description": "Doorbell stride in bytes = 2^(2+DSTRD); 0h = 4 bytes."},
        {"bits": "31:24", "name": "TO",     "long_name": "Timeout",           "description": "Worst-case CSTS.RDY transition time in 500 ms units."},
        {"bits": "23:19", "name": "Reserved",                                "description": "Reserved."},
        {"bits": "18:17", "name": "AMS",    "long_name": "Arbitration Mechanism Supported","description": "Bit 17 = WRR-Urgent; Bit 18 = Vendor Specific."},
        {"bit":  16,      "name": "CQR",    "long_name": "Contiguous Queues Required","description": "1 = controller requires physically contiguous I/O SQ/CQ."},
        {"bits": "15:0",  "name": "MQES",   "long_name": "Maximum Queue Entries Supported","description": "0's-based; max individual queue size."}
      ]
    },
    {
      "offset_h": "08", "name": "VS", "long_name": "Version", "width_bits": 32, "access": "RO",
      "fields": [
        {"bits": "31:16", "name": "MJR", "description": "Major version (1h for v1.4)."},
        {"bits": "15:8",  "name": "MNR", "description": "Minor version (4h for v1.4)."},
        {"bits": "7:0",   "name": "TER", "description": "Tertiary version (0h for v1.4)."}
      ]
    },
    {
      "offset_h": "0C", "name": "INTMS", "long_name": "Interrupt Mask Set", "width_bits": 32, "access": "RWS",
      "fields": [
        {"bits": "31:0", "name": "IVMS", "description": "Interrupt Vector Mask Set; write 1 to mask vector; read returns current mask. Not used when MSI-X."}
      ]
    },
    {
      "offset_h": "10", "name": "INTMC", "long_name": "Interrupt Mask Clear", "width_bits": 32, "access": "RWC",
      "fields": [
        {"bits": "31:0", "name": "IVMC", "description": "Interrupt Vector Mask Clear; write 1 to unmask vector."}
      ]
    },
    {
      "offset_h": "14", "name": "CC", "long_name": "Controller Configuration", "width_bits": 32, "access": "RW",
      "fields": [
        {"bits": "31:24", "name": "Reserved", "description": "Reserved."},
        {"bits": "23:20", "name": "IOCQES", "long_name": "I/O Completion Queue Entry Size", "description": "log2(CQE bytes); NVM Cmd Set requires 4 (16 B)."},
        {"bits": "19:16", "name": "IOSQES", "long_name": "I/O Submission Queue Entry Size", "description": "log2(SQE bytes); NVM Cmd Set requires 6 (64 B)."},
        {"bits": "15:14", "name": "SHN",    "long_name": "Shutdown Notification", "description": "00b = none; 01b = normal shutdown; 10b = abrupt shutdown."},
        {"bits": "13:11", "name": "AMS",    "long_name": "Arbitration Mechanism Selected", "description": "000b = Round Robin; 001b = Weighted Round Robin with Urgent Priority; 111b = Vendor Specific."},
