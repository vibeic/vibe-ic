        {"bit":  4,      "name": "NSSRO",    "long_name": "NVM Subsystem Reset Occurred", "description": "RWC, HwInit; 1 = last reset was NVM Subsystem Reset."},
        {"bits": "3:2", "name": "SHST",      "long_name": "Shutdown Status",   "description": "00b = normal; 01b = shutdown processing; 10b = shutdown complete."},
        {"bit":  1,      "name": "CFS",      "long_name": "Controller Fatal Status", "description": "1 = fatal controller error; processing stops."},
        {"bit":  0,      "name": "RDY",      "long_name": "Ready",             "description": "1 = controller ready to accept SQ doorbell writes."}
      ]
    },
