# =========================================================================
# Auto-generated by sdc_gen.py (Wave 72/73)
# Top entity: chip_top
# Clock: clk period=20 ns
# DO NOT hand-edit; regenerate via sdc_gen.py.
# =========================================================================

create_clock -name clk_main -period 20 [get_ports {clk}]
derive_pll_clocks
derive_clock_uncertainty

# Synchronous data inputs (moderate setup/hold)
set_input_delay  -clock clk_main -max 4.0 [get_ports {lc_escalate_en_i}]
set_input_delay  -clock clk_main -min 0.0 [get_ports {lc_escalate_en_i}]
set_input_delay  -clock clk_main -max 4.0 [get_ports {edn_i}]
set_input_delay  -clock clk_main -min 0.0 [get_ports {edn_i}]
set_input_delay  -clock clk_main -max 4.0 [get_ports {aes}]
set_input_delay  -clock clk_main -min 0.0 [get_ports {aes}]

# Outputs
set_output_delay -clock clk_main -max 4.0 [get_ports {idle_o}]
set_output_delay -clock clk_main -min 0.0 [get_ports {idle_o}]
set_output_delay -clock clk_main -max 4.0 [get_ports {edn_o}]
set_output_delay -clock clk_main -min 0.0 [get_ports {edn_o}]

# Async inputs / open-drain shared bus → false_path
set_false_path -from [get_ports {keymgr_key_i}] -to [all_clocks]
set_false_path -from [all_clocks] -to [get_ports {keymgr_key_i}]

