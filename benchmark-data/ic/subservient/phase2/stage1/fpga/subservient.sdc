# Outputs
set_output_delay -clock clk_main -max 4.0 [get_ports {o_sram_addr}]
set_output_delay -clock clk_main -min 0.0 [get_ports {o_sram_addr}]
set_output_delay -clock clk_main -max 4.0 [get_ports {o_sram_data}]
