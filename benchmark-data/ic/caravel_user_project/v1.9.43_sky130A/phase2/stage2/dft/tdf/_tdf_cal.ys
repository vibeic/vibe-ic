read_verilog /work/phase2/stage2/dft/tdf/flat_core.v /work/phase2/stage2/dft/tdf/loc_miter.v
copy user_project_wrapper user_project_wrapper_f
hierarchy -top miter
flatten
design -save baseflat
log VIBEICTDF_SETUP_DONE
design -load baseflat
connect -nomap -set fb._0484_ 1'b0
log VIBEICTDF _0484_ STR
sat -prove trig 0 -timeout 180 -select-solver kissat -set f1._0484_ 1'b0 -show wb_clk_i -show wb_rst_i -show wbs_stb_i -show wbs_cyc_i -show wbs_we_i -show wbs_sel_i -show wbs_dat_i -show wbs_adr_i -show la_data_in -show la_oenb -show io_in -show user_clock2
design -load baseflat
connect -nomap -set fb._1043_ 1'b0
log VIBEICTDF _1043_ STR
sat -prove trig 0 -timeout 180 -select-solver kissat -set f1._1043_ 1'b0 -show wb_clk_i -show wb_rst_i -show wbs_stb_i -show wbs_cyc_i -show wbs_we_i -show wbs_sel_i -show wbs_dat_i -show wbs_adr_i -show la_data_in -show la_oenb -show io_in -show user_clock2
design -load baseflat
connect -nomap -set fb._250__B 1'b1
log VIBEICTDF _250__B STF
sat -prove trig 0 -timeout 180 -select-solver kissat -set f1._250__B 1'b1 -show wb_clk_i -show wb_rst_i -show wbs_stb_i -show wbs_cyc_i -show wbs_we_i -show wbs_sel_i -show wbs_dat_i -show wbs_adr_i -show la_data_in -show la_oenb -show io_in -show user_clock2
