[tasks]
safety   prove
bmc      bmc

[options]
safety: mode prove
safety: depth 20
bmc:    mode bmc
bmc:    depth 12
aigsmt none

[engines]
safety: abc pdr
bmc:    abc bmc3

[script]
safety: read_verilog -formal -DSPM_SAFETY_ONLY formal_counter.sv defines.v user_defines.v user_proj_example.v user_project_wrapper.v
~safety: read_verilog -formal -DSPM_RESET_AT_T0 formal_counter.sv defines.v user_defines.v user_proj_example.v user_project_wrapper.v
prep -top formal_counter

[files]
defines.v
user_defines.v
user_proj_example.v
user_project_wrapper.v
formal_counter.sv
