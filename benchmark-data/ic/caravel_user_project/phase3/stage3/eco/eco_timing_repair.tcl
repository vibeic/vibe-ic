link_design user_project_wrapper
read_sdc /foss/designs/_bench7_caravel_v1034_cleanroom/caravel_r11/phase3/stage3/pnr/constraint.sdc

if {[catch {set_wire_rc -signal -layer met1} _swr_sig]} {
  if {[catch {set_wire_rc -layer met1} _swr_sig2]} {
    puts "ECO_SET_WIRE_RC_SIGNAL_NONFATAL: $_swr_sig2"
  }
}
if {[catch {set_wire_rc -clock -layer met5} _swr_clk]} {
  puts "ECO_SET_WIRE_RC_CLOCK_NONFATAL: $_swr_clk"
}

# ORGANIC #561 (a): RSZ-0074 — read post_hold.def as ECO start-point.
# post_hold.def is the last pre-route, hold-fixed DEF; reading
# routed.def carries stale GR guides that trigger RSZ-0074 abort.
read_def /foss/designs/_bench7_caravel_v1034_cleanroom/caravel_r11/phase3/stage3/pnr/post_hold.def

# === ECO pass 1: placement-based repair ===
if {[catch {estimate_parasitics -placement} _pe_pl]} {
  puts "ECO_EST_PARASITICS_PL_NONFATAL: $_pe_pl"
}
if {[catch {repair_design} _rd_err]} {
  puts "ECO_REPAIR_DESIGN_NONFATAL: $_rd_err"
}
if {[catch {repair_timing -setup} _rts_err]} {
  puts "ECO_REPAIR_TIMING_SETUP_NONFATAL: $_rts_err"
}
if {[catch {detailed_placement} _dp_err]} {
  puts "ECO_DETAILED_PLACEMENT_NONFATAL: $_dp_err"
}
# ORGANIC #561 (d): DPL-0033 — catch around check_placement.
# check_placement throws on inherited mis-aligned instances; catch
# keeps the flow moving while still surfacing the WARN message.
if {[catch {check_placement} _cp_err]} {
  puts "ECO_CHECK_PLACEMENT_WARN: $_cp_err"
} else {
  puts "ECO_CHECK_PLACEMENT_PASS"
}

# ORGANIC #561 (c): DRT-0305 — PG net cleanup before global_route.
# A dangling zero_/one_ constant-tie net with POWER/GROUND SigType in
# regular NETS makes TritonRoute abort ALL detailed routing.
if {[catch {
  set _blk [ord::get_db_block]
  set _pgdel 0; set _pgsig 0
  foreach _net [$_blk getNets] {
    set _st [$_net getSigType]
    if {($_st eq "POWER" || $_st eq "GROUND") && ![$_net isSpecial]} {
      if {[llength [$_net getITerms]] == 0 && [llength [$_net getBTerms]] == 0} {
        puts "PG_CLEANUP_DEL: [$_net getName] ($_st)"
        odb::dbNet_destroy $_net; incr _pgdel
      } else {
        puts "PG_CLEANUP_SIG: [$_net getName] ($_st)"
        $_net setSigType SIGNAL; incr _pgsig
      }
    }
  }
  puts "PG_CLEANUP_DONE: deleted=$_pgdel reclassified=$_pgsig"
} _pgc]} { puts "PG_CLEANUP_NONFATAL: $_pgc" }

global_route

# === ECO pass 2: post-GR setup-only repair ===
# ORGANIC #561 (b): Signal-11 (segfault) — pass-2 is setup-only.
# repair_design's repairDriver segfaults on some gate configs when
