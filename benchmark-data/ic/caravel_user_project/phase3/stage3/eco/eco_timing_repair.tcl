if {[catch {detailed_placement} _dpl2]} { puts "ECO_GR_REPAIR_LEGALIZE_NONFATAL: $_dpl2" }
if {[catch {detailed_route} _dr_err]} {
  puts "ECO_DETAILED_ROUTE_NONFATAL: $_dr_err"
}
