read_verilog -lib /home/reyerchu/vibe-ic/benchmark-data/ic/edge_llm_accel/reports/phase3/physical_cell_stubs.v
read_verilog -sv /home/reyerchu/vibe-ic/benchmark-data/ic/edge_llm_accel/phase2/stage2/synth/edge_llm_accel_synth.v
prep -top edge_llm_accel
splitnets -ports
design -stash gold

read_liberty -lib /foss/pdks/nangate45/libs.ref/NangateOpenCellLibrary/lib/NangateOpenCellLibrary_typical.lib
read_verilog -lib /home/reyerchu/vibe-ic/benchmark-data/ic/edge_llm_accel/reports/phase3/physical_cell_stubs.v
read_verilog -sv /home/reyerchu/vibe-ic/benchmark-data/ic/edge_llm_accel/phase3/stage3/pnr/edge_llm_accel_pnr.v
prep -top edge_llm_accel
splitnets -ports
design -stash gate

design -copy-from gold -as gold edge_llm_accel
design -copy-from gate -as gate edge_llm_accel
