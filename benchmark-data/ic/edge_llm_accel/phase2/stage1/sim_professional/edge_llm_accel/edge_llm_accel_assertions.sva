// Auto-derived assertions for edge_llm_accel (professional_tb_gen).
// clock=clk edge=posedge reset=rst_n active_high=False
module edge_llm_accel_asserts (input clk, input rst_n);
  // host_rdata must be known (no X) when not in reset
  A_host_rdata_known: assert property (@(posedge clk) disable iff (!rst_n) !$isunknown(host_rdata));
  // busy must be known (no X) when not in reset
  A_busy_known: assert property (@(posedge clk) disable iff (!rst_n) !$isunknown(busy));
  // done must be known (no X) when not in reset
  A_done_known: assert property (@(posedge clk) disable iff (!rst_n) !$isunknown(done));
endmodule
