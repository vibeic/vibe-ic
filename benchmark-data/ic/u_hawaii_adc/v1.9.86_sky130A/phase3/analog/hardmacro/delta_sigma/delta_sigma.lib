/* Liberty timing model for delta_sigma OTA block -- u_hawaii_adc sky130A substitute */
/* Subckt: ds_ota. 5T single-stage NMOS-input OTA. */
/* sky130A: sky130_fd_pr__nfet_01v8 (input pair + tail), sky130_fd_pr__pfet_01v8 (load) */
/* DC gain (TT_27c): 41.9077 dB pre-layout / 42.6127 dB post-layout (ngspice, sky130A) */
/* 2026-08-04: the previous 55.14 dB / 30.8 MHz figures were contradicted by every  */
/* corner_results.json run in this project (39.32-42.13 dB) and are removed.        */

library (delta_sigma) {
  technology (cmos) ;
  delay_model : table_lookup ;
  nom_process : 1.0 ;
  nom_temperature : 27.0 ;
  nom_voltage : 1.8 ;
  time_unit : "1ns" ;
  voltage_unit : "1V" ;
  current_unit : "1mA" ;
  pulling_resistance_unit : "1kohm" ;
  capacitive_load_unit (1, pf) ;

  cell (delta_sigma) {
    area : 3549.8 ;  /* 71.800 um x 49.440 um -- magic LEF outline of the routed layout */
    cell_leakage_power : 0.002 ;

    pin (VDD) {
      direction : inout ;
      use : power ;
    }
    pin (VSS) {
      direction : inout ;
      use : ground ;
    }
    pin (VINP) {
      direction : input ;
      capacitance : 0.015 ;
    }
    pin (VINN) {
      direction : input ;
      capacitance : 0.015 ;
    }
    pin (VOUTA) {
      direction : output ;
      max_capacitance : 0.5 ;
    }
    pin (VBIAS) {
      direction : input ;
      capacitance : 0.01 ;
    }
  }
}
