/* Liberty timing model for ldo block -- u_hawaii_adc sky130A substitute */
/* A4 pre-layout  (ngspice, sky130A tt/27C): Vout=1.20690 V, PSRR@100Hz=-52.4901 dB */
/* A7 post-layout (extracted RC netlist)   : Vout=1.20781 V, PSRR@100Hz=-53.2685 dB */
/* This is a behavioral Liberty model for integration STA closure.            */
/* Design content: structure_and_geometry (device parameters solved vs spec)  */

library (ldo) {
  technology (cmos) ;
  delay_model : table_lookup ;
  time_unit : "1ns" ;
  voltage_unit : "1V" ;
  current_unit : "1mA" ;
  leakage_power_unit : "1nW" ;
  pulling_resistance_unit : "1kohm" ;
  capacitive_load_unit (1, pf) ;

  nom_process : 1.0 ;
  nom_temperature : 27.0 ;
  nom_voltage : 1.8 ;

  /* LDO operating point: sky130_fd_pr__pfet_01v8 pass device */
  /* Vout = 1.20690 V @ tt_27c, 1.8 V IOVDD, 0.6 V VREF, 0.8 V VBIAS */
  default_cell_leakage_power : 50.0 ;  /* ~50nW quiescent approximation */

  operating_conditions (typical) {
    process : 1.0 ;
    temperature : 27.0 ;
    voltage : 1.8 ;
  }
  default_operating_conditions : typical ;

  cell (ldo) {
    area : 154110.0 ;  /* 332.580 um x 463.470 um -- magic LEF outline of the routed layout */
    cell_leakage_power : 50.0 ;

    pin (IOVDD) {
      direction : inout ;
      capacitance : 0.1 ;
      is_pad : true ;
    }

    pin (VSS) {
      direction : inout ;
      capacitance : 0.1 ;
      is_pad : true ;
    }

    pin (VREF) {
      direction : input ;
      capacitance : 0.05 ;
      /* Reference input: sets output voltage via resistor divider */
    }

    pin (VBIAS) {
      direction : input ;
      capacitance : 0.01 ;
      /* bias input -- was an ideal in-block source before the 2026-08-04 A3 revision */
    }

    pin (VOUT) {
      direction : output ;
      capacitance : 0.5 ;
      max_capacitance : 100.0 ;
      /* LDO output: Vout = VREF * (1 + R1/R2) = 0.6 * 2 = 1.2V */
    }
  }
}
