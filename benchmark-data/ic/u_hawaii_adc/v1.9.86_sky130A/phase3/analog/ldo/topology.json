  "spec_knobs": [
    {
      "name": "divider_ratio",
      "expr": "vout / vref",
      "default": 2.0,
      "rationale": "the feedback divider sets Vout = Vref * (1 + r1/r2); with only Vout bound the ratio is undetermined and the library default stands in"
