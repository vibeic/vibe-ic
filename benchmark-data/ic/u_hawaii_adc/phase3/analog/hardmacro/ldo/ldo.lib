library (ldo) {
  technology (cmos) ;
  delay_model : table_lookup ;
  time_unit : "1ns" ; voltage_unit : "1V" ; current_unit : "1mA" ;
  /* analog hardmacro abstract -- u_hawaii_adc LDO (IHP SG13G2). MODELED. */
  cell (ldo) {
    area : 3600 ;
    pg_pin (IOVDD) { pg_type : primary_power ; voltage_name : "VIN_1V8" ; }
    pg_pin (VSS)   { pg_type : primary_ground ; voltage_name : "VSS" ; }
    pin (VREF) { direction : input ; capacitance : 0.01 ; }
    pin (VOUT) { direction : output ; max_capacitance : 10.0 ;
                 /* regulated 1.2V CORE; Iq~6uA; PSRR>74dB; dropout<0.05V (modeled) */ }
  }
}
