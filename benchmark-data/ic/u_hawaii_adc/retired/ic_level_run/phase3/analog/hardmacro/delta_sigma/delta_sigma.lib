library (delta_sigma) {
  technology (cmos) ;
  delay_model : table_lookup ;
  time_unit : "1ns" ; voltage_unit : "1V" ; current_unit : "1mA" ;
  /* analog hardmacro abstract -- u_hawaii_adc 2nd-order incremental DSM (SG13G2). MODELED. */
  cell (delta_sigma) {
    area : 14400 ;
    pg_pin (VDD) { pg_type : primary_power ; voltage_name : "CORE_1V2" ; }
    pg_pin (VSS) { pg_type : primary_ground ; voltage_name : "VSS" ; }
    pin (INP)  { direction : input ; capacitance : 0.02 ; }
    pin (INN)  { direction : input ; capacitance : 0.02 ; }
    pin (VREF) { direction : input ; capacitance : 0.01 ; }
    pin (CLK)  { direction : input ; clock : true ; }
    pin (BS)   { direction : output ; /* 1-bit modulator bitstream; ENOB>=14 @OSR=256 (cosim) */ }
  }
}
