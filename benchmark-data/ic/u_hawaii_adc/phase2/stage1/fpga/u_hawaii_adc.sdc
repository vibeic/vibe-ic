create_clock -name clk_main -period 20 [get_ports {clk}]
derive_pll_clocks
derive_clock_uncertainty

# Synchronous data inputs (moderate setup/hold)
set_input_delay  -clock clk_main -max 4.0 [get_ports {vhi}]
