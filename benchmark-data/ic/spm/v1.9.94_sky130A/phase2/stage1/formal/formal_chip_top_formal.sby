[tasks]
safety   prove
bmc      bmc

[options]
safety: mode prove
safety: depth 20
bmc:    mode bmc
bmc:    depth 12
aigsmt none

[engines]
safety: abc pdr
bmc:    abc bmc3

[script]
safety: read_verilog -formal -DSPM_SAFETY_ONLY formal_chip_top.sv chip_top.v
~safety: read_verilog -formal -DSPM_RESET_AT_T0 formal_chip_top.sv chip_top.v
prep -top formal_chip_top

[files]
chip_top.v
formal_chip_top.sv
