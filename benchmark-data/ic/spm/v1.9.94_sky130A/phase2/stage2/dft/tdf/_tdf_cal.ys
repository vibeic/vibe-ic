read_verilog /work/phase2/stage2/dft/tdf/flat_core.v /work/phase2/stage2/dft/tdf/loc_miter.v
copy chip_top chip_top_f
hierarchy -top miter
flatten
design -save baseflat
log VIBEICTDF_SETUP_DONE
design -load baseflat
connect -nomap -set fb._0509_ 1'b0
log VIBEICTDF _0509_ STR
sat -prove trig 0 -timeout 180 -select-solver kissat -set f1._0509_ 1'b0 -show clk -show rst -show x -show y
design -load baseflat
connect -nomap -set fb._1048_ 1'b0
log VIBEICTDF _1048_ STR
sat -prove trig 0 -timeout 180 -select-solver kissat -set f1._1048_ 1'b0 -show clk -show rst -show x -show y
design -load baseflat
connect -nomap -set fb._291__A 1'b0
log VIBEICTDF _291__A STR
sat -prove trig 0 -timeout 180 -select-solver kissat -set f1._291__A 1'b0 -show clk -show rst -show x -show y
