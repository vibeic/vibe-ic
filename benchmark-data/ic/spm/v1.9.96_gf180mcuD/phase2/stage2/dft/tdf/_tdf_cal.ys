read_verilog /work/phase2/stage2/dft/tdf/flat_core.v /work/phase2/stage2/dft/tdf/loc_miter.v
copy chip_top chip_top_f
hierarchy -top miter
flatten
design -save baseflat
log VIBEICTDF_SETUP_DONE
design -load baseflat
connect -nomap -set fb._0459_ 1'b0
log VIBEICTDF _0459_ STR
sat -prove trig 0 -timeout 180 -select-solver kissat -set f1._0459_ 1'b0 -show clk -show rst -show x -show y
design -load baseflat
connect -nomap -set fb._0913_ 1'b0
log VIBEICTDF _0913_ STR
sat -prove trig 0 -timeout 180 -select-solver kissat -set f1._0913_ 1'b0 -show clk -show rst -show x -show y
design -load baseflat
connect -nomap -set fb._275__A1 1'b1
log VIBEICTDF _275__A1 STF
sat -prove trig 0 -timeout 180 -select-solver kissat -set f1._275__A1 1'b1 -show clk -show rst -show x -show y
