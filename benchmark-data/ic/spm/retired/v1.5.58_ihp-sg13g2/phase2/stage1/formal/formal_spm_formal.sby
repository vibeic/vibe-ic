[tasks]
safety   prove
bmc      bmc

[options]
safety: mode prove
safety: depth 20
bmc:    mode bmc
bmc:    depth 12
aigsmt none

[engines]
safety: abc pdr
bmc:    abc bmc3

[script]
safety: read_verilog -formal -DSPM_SAFETY_ONLY formal_spm.sv spm.v
~safety: read_verilog -formal -DSPM_RESET_AT_T0 formal_spm.sv spm.v
prep -top formal_spm

[files]
spm.v
formal_spm.sv
