# =========================================================================
# Auto-generated by sdc_gen.py (Wave 72/73)
# Top entity: spm
# Clock: clk period=10 ns
# DO NOT hand-edit; regenerate via sdc_gen.py.
# =========================================================================

create_clock -name clk_main -period 10 [get_ports {clk}]
derive_pll_clocks
derive_clock_uncertainty

# Synchronous data inputs (moderate setup/hold)
set_input_delay  -clock clk_main -max 4.0 [get_ports {x}]
set_input_delay  -clock clk_main -min 0.0 [get_ports {x}]
set_input_delay  -clock clk_main -max 4.0 [get_ports {y}]
set_input_delay  -clock clk_main -min 0.0 [get_ports {y}]

# Outputs
set_output_delay -clock clk_main -max 4.0 [get_ports {p}]
set_output_delay -clock clk_main -min 0.0 [get_ports {p}]

# Async inputs / open-drain shared bus → false_path
set_false_path -from [get_ports {rst}] -to [all_clocks]
set_false_path -from [all_clocks] -to [get_ports {rst}]

