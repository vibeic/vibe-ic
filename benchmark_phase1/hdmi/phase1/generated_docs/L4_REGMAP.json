        {
          "bits": "4",
          "name": "HEN",
          "description": "HSYNC enable."
        },
        {
          "bits": "3",
          "name": "DSEL",
          "description": "Diff/SE clock select (combined with BSEL+VREF)."
        },
        {
          "bits": "2",
          "name": "BSEL",
          "description": "0=12-bit dual-edge; 1=24-bit single-edge."
        },
        {
          "bits": "1",
          "name": "EDGE",
          "description": "0=falling edge of IDCK+; 1=rising."
        },
        {
          "bits": "0",
          "name": "PD",
          "description": "Power-down (0=PD; 1=normal). Default after RESET: 0."
