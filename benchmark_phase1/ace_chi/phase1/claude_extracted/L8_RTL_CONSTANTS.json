      "0b10": "Outer Shareable",
      "0b11": "System"
    },
    "AxBAR_encoding_2bit": {
      "0b00": "Normal access (not a barrier)",
      "0b01": "Memory Barrier",
      "0b10": "Normal access (reserved)",
      "0b11": "Synchronization Barrier"
    },
    "RRESP_extended_meaning_4bit": {
      "0b0000": "OKAY  + IsShared=0, PassDirty=0 (UniqueClean)",
      "0b0100": "OKAY  + IsShared=0, PassDirty=1 (UniqueDirty pass)",
      "0b1000": "OKAY  + IsShared=1, PassDirty=0 (SharedClean)",
      "0b1100": "OKAY  + IsShared=1, PassDirty=1 (SharedDirty pass)",
      "0b0001": "EXOKAY (only for ReadNoSnoop/ReadClean/ReadShared/CleanUnique)",
      "0b0010": "SLVERR",
      "0b0011": "DECERR"
    },
    "BRESP_extended_meaning_3bit": {
      "0b000": "OKAY  + DataTransfer=0",
      "0b100": "OKAY  + DataTransfer=1 (used for WriteUnique/WriteLineUnique)",
      "0b001": "EXOKAY",
      "0b010": "SLVERR",
      "0b011": "DECERR"
    },
    "CRRESP_bit_meaning_5bit": {
      "CRRESP[0]": "DataTransfer — full cache line of data will follow on CD",
      "CRRESP[1]": "Error — snoop failed",
      "CRRESP[2]": "PassDirty — cache line was dirty; responsibility transferred",
      "CRRESP[3]": "IsShared — snooped cache retains a copy after snoop",
      "CRRESP[4]": "WasUnique — cache line was Unique before this snoop"
    },
    "cache_line_state_codes_5state": {
      "UC": "UniqueClean — only this cache, matches memory",
      "UD": "UniqueDirty — only this cache, differs from memory, owns write-back",
      "SC": "SharedClean — multiple caches may have copy, matches memory",
      "SD": "SharedDirty — multiple caches may have copy, differs from memory, owns write-back",
      "I":  "Invalid — line not present"
    },
    "burst_length_formula_inherited": {
      "AXI3": "Burst_Length = AxLEN[3:0] + 1   (range 1..16)",
      "AXI4_ACE": "Burst_Length = AxLEN[7:0] + 1   (INCR: 1..256; FIXED/WRAP: 1..16; cache-line bursts typically 1, 2, 4, 8, 16)"
    },
    "snoop_data_constraint": "All cache-line-size transactions on CD must use the full CDDATA bus width. Burst length on CD must be one of 1, 2, 4, 8, or 16 (sized to cover the cache line).",
