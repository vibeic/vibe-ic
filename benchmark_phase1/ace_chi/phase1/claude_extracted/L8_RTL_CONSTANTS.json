      "0b001": "WriteLineUnique",
      "0b010": "WriteClean",
      "0b011": "WriteBack",
      "0b100": "Evict",
      "0b101": "WriteEvict (requires AWUNIQUE)"
    },
    "AxDOMAIN_encoding_2bit": {
      "0b00": "Non-shareable",
