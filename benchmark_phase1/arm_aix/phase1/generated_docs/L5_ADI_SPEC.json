    "analog_digital_interface_present": false,
    "rationale": "AXI/ACE is a purely digital, synchronous on-chip bus protocol. There are no analog signals, no DC electrical specifications, no AC timing parameters, no IO standards.",
    "signaling_summary": {
      "clock": "Single ACLK per ACE interface; rising-edge sampled.",
      "reset": "Single active-LOW ARESETn. Async assert, sync deassert.",
      "io_count": "All AXI + ACE channels are unidirectional. No tri-state, no open-drain, no analog.",
      "default_state_during_reset": "Master drives ARVALID/AWVALID/WVALID/CRVALID/CDVALID LOW; interconnect drives RVALID/BVALID/ACVALID LOW.",
      "combinatorial_path_rule": "No combinatorial paths between input and output signals. Applies equally to AC/CR/CD snoop channels."
