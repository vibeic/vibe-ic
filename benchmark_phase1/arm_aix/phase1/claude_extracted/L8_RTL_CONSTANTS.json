    {"spec_page": "A4-75", "spec_section": "A4.7 Access permissions / Table A4-6", "quote": "AxPROT[2:0]: bit0=Privileged, bit1=Non-secure, bit2=Instruction."},
    {"spec_page": "A7-100", "spec_section": "A7.4 Tables A7-1, A7-2", "quote": "AXI3 AxLOCK[1:0]: 00=Normal,01=Exclusive,10=Locked,11=Reserved. AXI4 1-bit AxLOCK: 0=Normal, 1=Exclusive."},
    {"spec_page": "A9-110", "spec_section": "A9.3 Default signal values / Table A9-1", "quote": "AWBURST default 0b01, INCR. AWLEN default All zeros, Length 1. AWSIZE default Data bus width. AWCACHE default 0b0000. AWQOS default 0b0000. WSTRB default All ones."},
    {"spec_page": "A7-97", "spec_section": "A7.2.4 Exclusive access restrictions", "quote": "The number of bytes to be transferred in an exclusive access burst must be a power of 2: 1,2,4,8,16,32,64,128. The maximum number of bytes is 128. Burst length must not exceed 16 transfers."}
