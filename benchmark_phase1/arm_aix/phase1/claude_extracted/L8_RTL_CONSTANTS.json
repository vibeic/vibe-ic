  "evidence": [
    {"spec_page": "A3-48 to A3-49", "spec_section": "A3.4.1 Burst length / Burst size / Table A3-2 / Table A3-3", "quote": "Burst_Length = AxLEN[7:0] + 1 (AXI4). AxSIZE[2:0]: 000=1, 001=2, 010=4, 011=8, 100=16, 101=32, 110=64, 111=128 bytes. AxBURST: 00=FIXED, 01=INCR, 10=WRAP, 11=Reserved."},
