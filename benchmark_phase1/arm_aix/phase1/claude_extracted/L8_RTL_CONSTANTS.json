    {"spec_page": "A3-54", "spec_section": "A3.4.4 Write strobes", "quote": "There is one write strobe for each 8 bits of the write data bus, therefore WSTRB[n] corresponds to WDATA[(8n)+7:(8n)]."},
    {"spec_page": "A3-59", "spec_section": "A3.4.5 Table A3-5", "quote": "RRESP/BRESP encoding 0b00=OKAY, 0b01=EXOKAY, 0b10=SLVERR, 0b11=DECERR."},
