  "document_title": "PC16550D Universal Asynchronous Receiver/Transmitter with FIFOs",
  "document_number": "TL/C/8652",
  "manufacturer": "National Semiconductor Corporation",
  "revised_date": "June 1995",
  "copyright": "© 1995 National Semiconductor Corporation",
  "external_pins": [
