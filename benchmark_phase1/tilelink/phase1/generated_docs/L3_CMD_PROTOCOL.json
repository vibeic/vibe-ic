  "response_encodings": {
    "RRESP[1:0] / BRESP[1:0]": {
      "0b00": "OKAY    - normal access success (or exclusive failed)",
      "0b01": "EXOKAY  - exclusive access success",
      "0b10": "SLVERR  - slave error",
      "0b11": "DECERR  - decode error (no slave at address)"
    }
  },
  "lock_encodings": {
    "AXI3_AxLOCK[1:0]": {
