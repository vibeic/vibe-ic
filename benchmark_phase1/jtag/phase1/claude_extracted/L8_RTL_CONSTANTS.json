      ["Exit1IR",        "PauseIR",        "UpdateIR"],
      ["PauseIR",        "PauseIR",        "Exit2IR"],
      ["Exit2IR",        "ShiftIR",        "UpdateIR"],
      ["UpdateIR",       "RunTestIdle",    "SelectDRScan"]
    ]
  },
  "voltage_levels": {
