{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://defintek.io/schemas/ic-design-knowledge/v1",
  "title": "Vibe-IC Design Knowledge Schema",
  "description": "Canonical JSON schema for all IC design knowledge files. All design JSONs must conform to this structure. Key naming conventions: no unit suffixes (vdd_min not vdd_min_v), units documented in field descriptions.",
  "version": "1.0.0",
  "type": "object",
  "required": ["part_number"],
  "properties": {
    "part_number": {
      "type": "string",
      "description": "IC part number (e.g., ADS1115, STM32F103)"
    },
    "manufacturer": {
      "type": ["string", "null"],
      "description": "Manufacturer name (e.g., Texas Instruments, STMicroelectronics)"
    },
    "category": {
      "type": ["string", "null"],
      "description": "IC category (e.g., ADC, Microcontroller, Voltage Regulator)",
      "examples": [
        "ADC", "DAC", "Microcontroller", "Op-Amp", "Voltage Regulator",
        "DC-DC Converter", "Motor Driver", "Temperature Sensor",
        "IMU/Motion Sensor", "Interface/Transceiver", "Memory",
        "LED/Display Driver", "Power MOSFET", "FPGA", "Comparator",
        "Voltage Reference", "Timer", "Logic", "Battery Management",
        "Digital Isolator", "Clock/PLL", "USB Bridge",
        "Pressure Sensor", "Humidity Sensor", "Light Sensor",
        "Proximity Sensor", "GNSS/GPS", "Audio", "Magnetic Sensor",
        "Multiplexer/Switch", "PWM Controller"
      ]
    },
    "description": {
      "type": ["string", "null"],
      "description": "Short description of the IC (one-liner from datasheet front page)"
    },
    "extracted_from": {
      "type": ["string", "null"],
      "description": "Source document reference (e.g., 'ADS1115 datasheet SBAS444E, 57 pages')"
    },
    "extracted_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "ISO 8601 timestamp of extraction"
    },
    "extraction_method": {
      "type": ["string", "null"],
      "description": "How data was extracted (e.g., 'pdftotext+regex', 'ai-assisted', 'manual')"
    },

    "basic_specs": {
      "type": "object",
      "description": "Core electrical and functional specifications. All voltages in volts, currents in microamps, temperatures in Celsius — no unit suffixes on key names.",
      "properties": {
        "vdd_min": {
          "type": ["number", "null"],
          "description": "Minimum supply voltage (V)"
        },
        "vdd_typ": {
          "type": ["number", "null"],
          "description": "Typical supply voltage (V)"
        },
        "vdd_max": {
          "type": ["number", "null"],
          "description": "Maximum supply voltage (V)"
        },
        "temp_min": {
          "type": ["number", "null"],
          "description": "Minimum operating temperature (°C)"
        },
        "temp_max": {
          "type": ["number", "null"],
          "description": "Maximum operating temperature (°C)"
        },
        "icc_typ": {
          "type": ["number", "null"],
          "description": "Typical operating supply current (µA)"
        },
        "icc_max": {
          "type": ["number", "null"],
          "description": "Maximum operating supply current (µA)"
        },
        "icc_powerdown_typ": {
          "type": ["number", "null"],
          "description": "Typical power-down / standby current (µA)"
        },
        "icc_powerdown_max": {
          "type": ["number", "null"],
          "description": "Maximum power-down / standby current (µA)"
        },
        "resolution_bits": {
          "type": ["integer", "null"],
          "description": "ADC/DAC resolution in bits"
        },
        "interfaces": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of communication interfaces (e.g., ['I2C', 'SPI']). Always an array, never a string.",
          "examples": [["I2C"], ["SPI", "UART"], ["I2C", "SPI", "USB"]]
        },
        "packages": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Available packages (e.g., ['SOIC-8', 'QFN-16']). Always an array.",
          "examples": [["QFN-10", "VSSOP-10"]]
        },
        "pin_count": {
          "type": ["integer", "null"],
          "description": "Total pin count (most common package)"
        },
        "architecture": {
          "type": ["string", "null"],
          "description": "IC architecture (e.g., 'delta-sigma', 'SAR', 'ARM Cortex-M4')"
        },
        "sample_rate_sps": {
          "oneOf": [
            { "type": "integer" },
            { "type": "array", "items": { "type": "integer" } },
            { "type": "null" }
          ],
          "description": "Sample rate in SPS — single value or array of all supported rates"
        },
        "sample_rate_ksps": {
          "type": ["number", "null"],
          "description": "Sample rate in kSPS (if SPS is too small a unit)"
        },
        "sample_rate_msps": {
          "type": ["number", "null"],
          "description": "Sample rate in MSPS"
        },
        "freq_mhz": {
          "type": ["number", "null"],
          "description": "Operating frequency / clock in MHz"
        },
        "freq_ghz": {
          "type": ["number", "null"],
          "description": "Operating frequency / clock in GHz"
        },
        "channels_differential": {
          "type": ["integer", "null"],
          "description": "Number of differential input channels"
        },
        "channels_single_ended": {
          "type": ["integer", "null"],
          "description": "Number of single-ended input channels"
        },
        "i2c_speed_modes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Supported I2C speed modes (e.g., ['standard', 'fast', 'high-speed'])"
        },
        "i2c_max_freq_mhz": {
          "type": ["number", "null"],
          "description": "Maximum I2C clock frequency (MHz)"
        },
        "flash_kb": {
          "type": ["integer", "null"],
          "description": "Flash memory size in KB (for MCUs)"
        },
        "sram_kb": {
          "type": ["integer", "null"],
          "description": "SRAM size in KB (for MCUs)"
        },
        "gpio_count": {
          "type": ["integer", "null"],
          "description": "Number of GPIO pins (for MCUs)"
        },
        "cpu_core": {
          "type": ["string", "null"],
          "description": "CPU core type (e.g., 'ARM Cortex-M4', 'Xtensa LX6')"
        },
        "output_type": {
          "type": ["string", "null"],
          "description": "Output type for DACs, regulators, etc. (e.g., 'voltage', 'current')"
        }
      },
      "additionalProperties": true
    },

    "pin_configuration": {
      "type": "object",
      "description": "Pin-out information. Must contain 'pins' array.",
      "properties": {
        "total_pins": {
          "type": ["integer", "null"],
          "description": "Total number of pins"
        },
        "pins": {
          "type": "array",
          "description": "Array of pin definitions. Always an array.",
          "items": {
            "type": "object",
            "required": ["pin", "name"],
            "properties": {
              "pin": {
                "oneOf": [
                  { "type": "integer" },
                  { "type": "string" }
                ],
                "description": "Pin number or identifier"
              },
              "name": {
                "type": "string",
                "description": "Pin name (e.g., 'VDD', 'SDA', 'AIN0')"
              },
              "type": {
                "type": ["string", "null"],
                "description": "Pin type (e.g., 'power', 'ground', 'analog_input', 'digital_io', 'digital_input', 'digital_output')"
              },
              "description": {
                "type": ["string", "null"],
                "description": "Pin function description"
              }
            }
          }
        }
      },
      "required": ["pins"]
    },

    "register_map": {
      "type": "object",
      "description": "Register definitions. Must contain 'registers' array at this level.",
      "properties": {
        "access_method": {
          "type": ["string", "null"],
          "description": "How registers are accessed (e.g., 'Address Pointer register selects target')"
        },
        "registers": {
          "type": "array",
          "description": "Array of register definitions. Always an array.",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string",
                "description": "Register name"
              },
              "address": {
                "type": ["string", "integer", "null"],
                "description": "Register address (hex string or integer)"
              },
              "width_bits": {
                "type": ["integer", "null"],
                "description": "Register width in bits"
              },
              "reset": {
                "type": ["string", "integer", "null"],
                "description": "Reset/default value"
              },
              "access": {
                "type": ["string", "null"],
                "description": "Access type (e.g., 'R', 'W', 'R/W')"
              },
              "description": {
                "type": ["string", "null"],
                "description": "Register description"
              },
              "fields": {
                "type": "array",
                "description": "Bit fields within the register",
                "items": {
                  "type": "object",
                  "required": ["name"],
                  "properties": {
                    "bits": {
                      "type": ["string", "null"],
                      "description": "Bit range (e.g., '15:12', '7', '1:0')"
                    },
                    "name": {
                      "type": "string",
                      "description": "Field name"
                    },
                    "access": {
                      "type": ["string", "null"],
                      "description": "Field access type (R, W, R/W)"
                    },
                    "reset": {
                      "type": ["string", "integer", "null"],
                      "description": "Field reset value"
                    },
                    "description": {
                      "type": ["string", "null"],
                      "description": "Field description"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "required": ["registers"]
    },

    "i2c_addressing": {
      "type": "object",
      "description": "I2C address configuration",
      "properties": {
        "address_pin": {
          "type": ["string", "null"],
          "description": "Name of the address selection pin"
        },
        "fixed_address": {
          "type": ["string", "null"],
          "description": "Fixed I2C address if not configurable (hex string)"
        },
        "addresses": {
          "type": "array",
          "description": "Array of address configurations",
          "items": {
            "type": "object",
            "properties": {
              "addr_pin": {
                "type": ["string", "null"],
                "description": "Address pin connection (e.g., 'GND', 'VDD')"
              },
              "address_7bit": {
                "type": ["string", "null"],
                "description": "7-bit I2C address (hex string, e.g., '0x48')"
              }
            }
          }
        }
      }
    },

    "electrical_characteristics": {
      "type": ["object", "null"],
      "description": "Detailed electrical specs beyond basic_specs (DC params, noise, CMRR, etc.). Structure is IC-specific.",
      "additionalProperties": true
    },

    "absolute_maximum_ratings": {
      "type": ["object", "null"],
      "description": "Absolute maximum ratings (voltages, currents, temperatures that must not be exceeded). Structure is IC-specific.",
      "additionalProperties": true
    },

    "application_info": {
      "type": ["object", "null"],
      "description": "Application and design guidance",
      "properties": {
        "typical_circuit": {
          "type": ["string", "null"],
          "description": "Text description of typical application circuit"
        },
        "decoupling": {
          "type": ["string", "null"],
          "description": "Decoupling capacitor recommendations"
        },
        "input_protection": {
          "type": ["string", "null"],
          "description": "Input protection guidelines"
        },
        "pullup_resistors": {
          "type": ["string", "null"],
          "description": "Pull-up resistor recommendations"
        },
        "oscillator": {
          "type": ["string", "null"],
          "description": "Oscillator / clock source information"
        },
        "reference": {
          "type": ["string", "null"],
          "description": "Voltage reference information"
        },
        "pcb_layout": {
          "type": ["string", "null"],
          "description": "PCB layout guidelines"
        }
      },
      "additionalProperties": true
    },

    "design_notes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of important design notes and caveats. Always an array of strings."
    },

    "timing": {
      "type": ["object", "null"],
      "description": "Timing specifications (setup/hold times, propagation delays, etc.). Structure is IC-specific.",
      "additionalProperties": true
    },

    "functional_modes": {
      "type": ["object", "null"],
      "description": "Operational modes and their descriptions. Structure is IC-specific.",
      "additionalProperties": true
    },

    "power_modes": {
      "type": ["object", "null"],
      "description": "Power modes (active, sleep, deep-sleep, etc.). Structure is IC-specific.",
      "additionalProperties": true
    },

    "block_diagram_description": {
      "type": ["string", "null"],
      "description": "Text description of the block diagram"
    }
  },

  "additionalProperties": true,

  "$defs": {
    "key_aliases": {
      "description": "Mapping of non-canonical key names to their canonical equivalents. Used by normalizer.py — NOT part of the validated schema.",
      "flat_to_basic_specs": {
        "vdd_min_v": "vdd_min",
        "vdd_max_v": "vdd_max",
        "vdd_typ_v": "vdd_typ",
        "supply_min": "vdd_min",
        "supply_max": "vdd_max",
        "supply_typ": "vdd_typ",
        "supply_voltage_min": "vdd_min",
        "supply_voltage_max": "vdd_max",
        "supply_voltage_v": "_special_range",
        "operating_voltage_min": "vdd_min",
        "operating_voltage_max": "vdd_max",
        "temp_min_c": "temp_min",
        "temp_max_c": "temp_max",
        "temp_operating_min": "temp_min",
        "temp_operating_max": "temp_max",
        "operating_temp_min": "temp_min",
        "operating_temp_max": "temp_max",
        "icc_operating_typ_ua": "icc_typ",
        "icc_operating_max_ua": "icc_max",
        "icc_typ_ua": "icc_typ",
        "icc_max_ua": "icc_max",
        "supply_current_typical_uA": "icc_typ",
        "supply_current_max_uA": "icc_max",
        "icc_powerdown_typ_ua": "icc_powerdown_typ",
        "icc_powerdown_max_ua": "icc_powerdown_max",
        "interface": "interfaces",
        "package": "packages"
      },
      "flat_to_top_level": {
        "pin_count": "basic_specs.pin_count",
        "interfaces": "basic_specs.interfaces",
        "packages": "basic_specs.packages",
        "resolution_bits": "basic_specs.resolution_bits",
        "vdd_min_v": "basic_specs.vdd_min",
        "vdd_max_v": "basic_specs.vdd_max",
        "temp_min_c": "basic_specs.temp_min",
        "temp_max_c": "basic_specs.temp_max",
        "freq_mhz": "basic_specs.freq_mhz",
        "freq_ghz": "basic_specs.freq_ghz",
        "sample_rate_sps": "basic_specs.sample_rate_sps",
        "sample_rate_ksps": "basic_specs.sample_rate_ksps",
        "sample_rate_msps": "basic_specs.sample_rate_msps"
      },
      "register_field_renames": {
        "type": "access",
        "pointer": "address"
      },
      "i2c_address_renames": {
        "addr_pin_connection": "addr_pin",
        "7bit_addr": "address_7bit",
        "address_hex": "address_7bit",
        "slave_address_hex": "address_7bit"
      }
    }
  }
}
