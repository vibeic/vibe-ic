{
  "schema_version": 1,
  "contract_id": "vibeic-benchmark-data-hygiene-v1",
  "owner_repository": "vibeic/benchmark-data",
  "canonical_remote": "https://github.com/vibeic/benchmark-data.git",
  "corpus_env": "VIBE_IC_BENCHMARK_DATA",
  "corpus_marker": ".vibe-ic-corpus.json",
  "external_runner": "tools/ci/benchmark_data_hygiene_gates.sh",
  "plugin_landing_runner": "tools/ci/repo_hygiene_gates.sh",
  "baselines": {
    "l_doc_field_producer": "ci/baselines/l_doc_field_producer_baseline.json",
    "cross_layer_reference": "ci/baselines/cross_layer_reference_baseline.json",
    "step_internal_fail_bubble_up": "ci/baselines/step_internal_fail_bubble_up_baseline.json"
  },
  "gates": [
    {
      "label": "L-doc field producer",
      "program": "l_doc_field_producer_check.py",
      "blocking": true
    },
    {
      "label": "tracked-symlink portability",
      "program": "tracked_symlink_portability_check.py",
      "blocking": true
    },
    {
      "label": "tracked-symlink target present",
      "program": "tracked_symlink_target_present_check.py",
      "blocking": true
    },
    {
      "label": "evidence citation resolves",
      "program": "evidence_citation_resolves_check.py",
      "blocking": true
    },
    {
      "label": "citation routing is true",
      "program": "citation_routing_is_true_check.py",
      "blocking": true
    },
    {
      "label": "cross-layer reference regression",
      "program": "cross_layer_reference_check.py",
      "blocking": true
    },
    {
      "label": "step FAIL bubbles up",
      "program": "step_internal_fail_bubble_up_check.py",
      "blocking": true
    },
    {
      "label": "L4 -> SystemRDL disposition",
      "program": "l4_systemrdl_export.py",
      "blocking": true
    },
    {
      "label": "published-evidence index honest",
      "program": "benchmark_evidence_index.py",
      "blocking": true
    },
    {
      "label": "published records not superseded",
      "program": "published_record_staleness_check.py",
      "blocking": true
    }
  ]
}
