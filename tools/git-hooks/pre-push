#!/usr/bin/env bash
# vibe-ic pre-push: scan each published ref with both mandatory NDA guards.
# Install with tools/install-git-hooks.sh.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
PROGRAMS="$REPO_ROOT/vibe-ic-marketplace/plugins/vibe-ic/programs"
REMOTE_NAME="${1:-origin}"
ZERO='0000000000000000000000000000000000000000'
FAILED=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue
  if [ "$remote_sha" = "$ZERO" ]; then
    RANGE="$local_sha --not --remotes=$REMOTE_NAME"
  else
    RANGE="${remote_sha}..${local_sha}"
  fi

  # The range contains only Git object IDs and fixed options read from Git.
  # shellcheck disable=SC2086
  if ! COUNT=$(git rev-list --count $RANGE); then
    echo "pre-push: NOT CHECKED — cannot read pushed range for $remote_ref" >&2
    exit 1
  fi
  [ "$COUNT" = "0" ] && continue

  for guard in commit_msg_nda_check.py nda_diff_scan_check.py; do
    rc=0
    # Keep private detector diagnostics out of hook output. Either guard's
    # failure or inability to run blocks the push, including a missing file.
    env -u GIT_DIR -u GIT_WORK_TREE python3 "$PROGRAMS/$guard" \
      --repo "$REPO_ROOT" --rev-range "$RANGE" \
      </dev/null >/dev/null 2>&1 || rc=$?
    if [ "$rc" -ne 0 ]; then
      echo "pre-push: BLOCKED — $guard did not pass for $remote_ref (rc=$rc)" >&2
      FAILED=1
    fi
  done
done

exit "$FAILED"
